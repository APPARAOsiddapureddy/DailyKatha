<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Do not use Theme.Black when the user has system dark mode on — Flutter UI is light chrome. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/splash_native</item>
        <item name="android:navigationBarColor">@color/splash_native</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/proto_cream</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/proto_cream</item>
        <item name="android:navigationBarColor">@color/proto_cream</item>
    </style>
</resources>
