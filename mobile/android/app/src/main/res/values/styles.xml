<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match Flutter splash (brand deep) until first frame -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/splash_native</item>
        <item name="android:navigationBarColor">@color/splash_native</item>
    </style>
    <!-- Cream behind Flutter after engine starts (prevents “all dark” on light-mode UI) -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/proto_cream</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/proto_cream</item>
        <item name="android:navigationBarColor">@color/proto_cream</item>
    </style>
</resources>
