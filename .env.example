# Flutter default API host (override with dart-define API_BASE): https://dailykatha-backend.onrender.com/v1
DATABASE_URL=postgresql://user:password@localhost:5432/dailykatha
# Local: redis://localhost:6379
# Upstash on Render: paste ONLY the URL from the Upstash console (redis:// or rediss://).
# Do NOT paste the full `redis-cli --tls -u ...` line — that breaks Node (EINVAL / bad host).
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_random_64_char_secret
INTERNAL_API_KEY=replace_with_hex_32_bytes
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
PORT=3000
NODE_ENV=production
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json

