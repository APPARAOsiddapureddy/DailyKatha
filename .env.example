# Workspace hints only — Flutter API URL is NOT read from this file.
# Mobile production: `flutter run` / build with `--dart-define=FLAVOR=production` (default) or
#   `--dart-define=API_BASE=https://dailykatha-backend.onrender.com/v1`
# See `mobile/lib/config/flavor_config.dart`.

