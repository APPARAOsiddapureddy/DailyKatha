NODE_ENV=development
ENVIRONMENT=development
PORT=3000

# Postgres — local Docker Compose maps 15432→5432 (see backend/docker-compose.yml)
# DATABASE_URL=postgresql://dailykatha:dailykatha@127.0.0.1:15432/dailykatha

# Managed / production (must include database name, e.g. /neondb). Neon: use pooler host (*-pooler.*).
# You may paste Neon’s full `psql 'postgresql://…'` line — it is normalized to the URI.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
# PG_POOL_MAX=10
# PG_IDLE_MS=10000
# PG_CONNECTION_TIMEOUT_MS=15000

# Redis — local Docker Compose maps 16379→6379
# REDIS_URL=redis://127.0.0.1:16379

# REDIS_URL=redis://host:6379

# JWT
JWT_SECRET=your-secret-key-here

# CORS allowlist (comma-separated)
CORS_WHITELIST=https://app.dailykatha.com,https://admin.dailykatha.com

# Logging
LOG_LEVEL=info
SERVICE_NAME=daily-katha-api
APP_VERSION=1.0.0

# Observability
SENTRY_DSN=https://your-sentry-dsn

# Rate limiting
API_RATE_LIMIT=100

# QA test lines (123456xxxx + fixed OTP): ON when unset in dev; OFF in production unless true.
# ENABLE_QA_SHORTCUTS=true

# SMS OTP (production). Numbers starting with 123456xxxx use fixed OTP only if ENABLE_QA_SHORTCUTS allows.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# MSG91_AUTHKEY=
# MSG91_SENDER=
# SMS_OTP_MESSAGE=Your Daily Katha verification code is {otp}. Do not share it with anyone.
# OTP_ALLOW_WITHOUT_SMS=true
